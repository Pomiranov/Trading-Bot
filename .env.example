# ─── База данных PostgreSQL ───────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=trading_bot
DB_USER=trader
DB_PASSWORD=your_password_here

# ─── Т-Инвестиции API ────────────────────────────────────────────────────────
TINKOFF_TOKEN=your_tinkoff_token_here
TINKOFF_ACCOUNT_ID=your_account_id_here
TINKOFF_SANDBOX=true          # true = песочница, false = боевой режим

# ─── Telegram ────────────────────────────────────────────────────────────────
TELEGRAM_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here
TELEGRAM_ALLOWED_IDS=          # доп. chat_id через запятую (опционально)

# ─── Dashboard (безопасность) ────────────────────────────────────────────────
DASHBOARD_HOST=127.0.0.1       # НЕ используйте 0.0.0.0 без reverse proxy + auth
DASHBOARD_PORT=5001
DASHBOARD_API_KEY=             # обязателен при публичном доступе; заголовок X-Dashboard-Api-Key
DASHBOARD_REQUIRE_API_KEY=false # true = ключ нужен и для GET /api/*

# ─── Риск: ручные заявки (Telegram / API) ────────────────────────────────────
RISK_MAX_MANUAL_LOTS=50

# ─── Торговые параметры ──────────────────────────────────────────────────────
TICKERS=SBER,GAZP,LKOH,NVTK
POLL_INTERVAL=60              # секунды между опросами сигналов

# ─── Форвард-контур (run_forward_d1.py / forward_healthcheck.py) ─────────────
FORWARD_CAPITAL=1000000       # бумажный капитал форварда, руб. — база на КАЖДЫЙ
                              # тикер, а не на весь портфель (см. ниже)
FORWARD_PER_TICKER_CAPITAL=true   # true (по умолчанию) — независимый бюджет на
                              # каждый тикер, паритет с потикерным бэктестом:
                              # форвард измеряет ПРАВИЛА, а не счёт.
                              # false/0/no/off — портфельный режим: общий счёт и
                              # лимит max_open_positions. Портфельные PF ни на
                              # один вопрос о доходности счёта не отвечают, пока
                              # не закрыт долг №17. Нераспознанное значение
                              # оставляет потикерный режим И пишет об этом в
                              # сводку — режим нельзя переключить опечаткой
FWD_MAX_AGE_DAYS=2            # свечи старше — сторож шлёт ⚠ (в норме бар вчерашний)
                              # можно только УЖЕСТОЧИТЬ: 1..3. Значение выше 3
                              # игнорируется, сторож берёт предел 3 и пишет об
                              # этом в сообщение — защиту нельзя ослабить тихо

# ─── Риск-менеджмент ─────────────────────────────────────────────────────────
RISK_MAX_POSITION_PCT=0.05    # максимальный % портфеля на одну позицию
RISK_ATR_STOP_MULT=2.0        # множитель ATR для стоп-лосса
RISK_MAX_DAILY_LOSS_PCT=0.02  # лимит дневных убытков (% портфеля)
RISK_MAX_OPEN_POSITIONS=5     # максимальное количество одновременных позиций

# ─── Secrets & encryption (Phase 1) ──────────────────────────────────────────
# 32-byte key as 64-char hex. When set, broker tokens are stored encrypted on disk.
SECRETS_MASTER_KEY=
# Optional HashiCorp Vault (overrides env when configured)
VAULT_ADDR=
VAULT_TOKEN=
VAULT_SECRET_PATH=

# ─── Внутренняя безопасность ──────────────────────────────────────────────────
# Shared token for internal SSE push endpoint. Generate with: python -c "import secrets; print(secrets.token_hex(32))"
QF_INTERNAL_TOKEN=

# ─── Приложение ──────────────────────────────────────────────────────────────
LOG_LEVEL=INFO                # DEBUG / INFO / WARNING / ERROR
LOG_FILE=logs/quantflow.log   # Rotating file log (10 MB × 5 files)
LOG_MAX_BYTES=10485760
LOG_BACKUP_COUNT=5
