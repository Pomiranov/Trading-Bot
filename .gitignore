knowledge/rules.yaml.backup

# Черновик очереди глав от tools/build_chapter_queue.py — рабочая очередь
# knowledge/queue/chapters.yaml версионируется, черновик нет.
knowledge/queue/chapters.draft.yaml

# ─── Node.js / Next.js ────────────────────────────────────────────────────────
node_modules/
.next/
.nuxt/
out/
dist/
.cache/
*.tsbuildinfo

# ─── macOS ────────────────────────────────────────────────────────────────────
.DS_Store
.AppleDouble
.LSOverride
Thumbs.db

# ─── Claude Code (local settings, worktrees) ──────────────────────────────────
# Определения субагентов — код проекта: без них tools/read_chapters.py не
# запустится ни у напарника на Mac, ни на Windows Server. Всё остальное
# (settings.local.json, worktrees, кэши) остаётся локальным.
.claude/*
!.claude/agents/

# Снимок контекста сессии: SessionEnd-хук перезаписывает его каждый раз, так что
# в git он вечно висел бы модифицированным.
.context-handoff.json

# ─── VS Code workspace ────────────────────────────────────────────────────────
*.code-workspace

# ─── Database dumps ───────────────────────────────────────────────────────────
*.sql.bak
*.dump

# ─── Temporary / OS ───────────────────────────────────────────────────────────
*.tmp
*.bak
*.swp
*~
# Word-локи: появляются при каждом открытии карточки в Word (~$ch04.md уже
# однажды чуть не уехал в коммит вместе с knowledge/cards/).
~$*

# ─── Артефакты прогонов бэктеста ──────────────────────────────────────────────
# run_osc_oos_debug.py пишет osc_debug_<label>.csv рядом с собой. Опасность не
# в мусоре в git, а в ИМЕНИ: в backtest/ (корень) лежат 11 отслеживаемых CSV
# до-merge прогонов, и раздел 5а держит по именам вариантов критерий
# воспроизводимости (a3_ema50: 173 / 33.5% / 1.05 / +162k). Новый файл с тем же
# именем, посчитанный на другом наборе правил или других данных, прочитается как
# провал или подтверждение — ложно в обе стороны. Прогоны описи и отладки
# складывать вне репозитория, а если файл всё же нужен рядом — имя с датой:
# inventory_YYYYMMDD_*.csv. Долг №24.
bot/backtest/*.csv
inventory_*.csv
