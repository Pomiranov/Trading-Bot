# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# ─── Hero media: heavy video sources stay local ───────────────────────────────
# Posters (*.webp) and README.md in these dirs ARE committed — the site must
# build and render correctly with every video below absent (poster-only).
# See docs/VIDEO_ASSET_GUIDE.md.
/public/media/**/*.mp4
/public/media/**/*.webm
/public/media/**/*.mov

